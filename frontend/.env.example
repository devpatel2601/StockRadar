# Firebase Web App config — values are PUBLIC (go into the browser bundle).
# Copy this file to .env and fill in your Firebase project values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Vite proxy forwards /api → Spring Boot backend (see vite.config.ts)
# If deploying to production, set the API base URL here:
# VITE_API_BASE_URL=https://your-backend-domain.com
